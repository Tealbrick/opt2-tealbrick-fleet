{
  "$schema": "https://spec.opt2.tealbrick.com/manifest.schema.json",
  "schema": "tealbrick.miniapp/2",
  "id": "fleet",
  "name": "Organization Plane",
  "summary": "Organization Plane is your workspace directory: teams, people, who owns which agent, and people's channel handles.",
  "description": "The workspace directory for your agents and the people they work with.\n\n- **Teams:** people and agents, each with a role (member or lead).\n- **People:** directory entries (not sign-ins) with their Buzz, Slack and Telegram handles, so a message sender becomes a known person.\n- **Agents:** every workspace agent, with its owner, role and teams.\n\nOther apps (for example Rules) read these facts. Organization Plane holds no policy and no credentials.",
  "version": "0.1.4",
  "sdkMajor": 1,
  "publisher": {
    "name": "Teal Brick opt2"
  },
  "source": {
    "repo": "https://github.com/Martin-Atrin/opt2-tealbrick-fleet",
    "license": "MIT"
  },
  "icon": {
    "svgPath": "M12 4a3 3 0 1 0 0 6a3 3 0 1 0 0-6z M5 13a2.5 2.5 0 1 0 0 5a2.5 2.5 0 1 0 0-5z M19 13a2.5 2.5 0 1 0 0 5a2.5 2.5 0 1 0 0-5z M12 10v3 M12 13l-5 2 M12 13l5 2",
    "viewBox": "0 0 24 24"
  },
  "discovery": {
    "category": "productivity",
    "intents": [
      "set up teams for my agents",
      "who owns this agent",
      "which team is this person in",
      "map a Buzz or Slack sender to a person"
    ],
    "keywords": [
      "teams",
      "people",
      "directory",
      "organization",
      "fleet",
      "owners"
    ]
  },
  "runtime": {
    "build": {
      "context": ".",
      "dockerfile": "Dockerfile"
    },
    "port": 8080,
    "healthPath": "/tb/v1/health",
    "resources": {
      "cpu": 0.25,
      "memoryMb": 256
    },
    "volumes": [
      {
        "id": "data",
        "mountPath": "/data",
        "sizeGb": 1,
        "purpose": "data"
      },
      {
        "id": "backup",
        "mountPath": "/backup",
        "sizeGb": 2,
        "purpose": "backup"
      }
    ]
  },
  "operations": [
    {
      "id": "teams_list",
      "title": "List teams",
      "description": "List the workspace teams with their members (people with their channel handles, agents), oldest first. Optional: only teams with a tag. Page with cursor = nextCursor.",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "tag": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,39}$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "teams",
          "nextCursor"
        ],
        "properties": {
          "teams": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "description",
                "tags",
                "people",
                "agents",
                "updatedAt",
                "members"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "people": {
                  "type": "integer"
                },
                "agents": {
                  "type": "integer"
                },
                "updatedAt": {
                  "type": "string"
                },
                "members": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id",
                      "name",
                      "role"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "person",
                          "agent"
                        ]
                      },
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "role": {
                        "enum": [
                          "member",
                          "lead"
                        ]
                      },
                      "handles": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "crud": [
        "read"
      ],
      "effect": "read",
      "idempotency": "none",
      "receipt": false,
      "audience": "agent"
    },
